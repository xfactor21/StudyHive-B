rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOperator() {
      return isSignedIn() && request.auth.token.email in [
        'xfactorxai@gmail.com',
        'chrisfrerking21@gmail.com'
      ];
    }

    function changedOnly(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function dmParticipants(conversationId) {
      return get(/databases/$(database)/documents/dms/$(conversationId)).data.participants;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);

      // Hunnies specifically: the owner may only DECREASE their own
      // balance (spending on gifts/cosmetics) - never increase it
      // directly. All increases now happen either through the
      // non-owner "someone else's action rewards me" exception below,
      // or server-side via the Admin SDK (Buzz rewards - see
      // functions/index.js), which bypasses these rules entirely as
      // trusted server code. Before this split, isOwner() granted full
      // write access to your own document, meaning anyone could set
      // their own hunnies to any value directly via the client SDK,
      // completely bypassing "earned, never bought."
      allow update: if (
        isOwner(userId) &&
        changedOnly(['hunnies']) &&
        request.resource.data.hunnies < resource.data.hunnies
      ) || (
        isOwner(userId) &&
        changedOnly(['hunnies', 'activeCosmetics']) &&
        request.resource.data.hunnies < resource.data.hunnies
      ) || (
        // Everything else about your own profile - name, bio, handle,
        // photo, status, classes, badges (append-only, checked below),
        // counters, etc. Badges may only grow, never shrink, even here -
        // a real user losing a badge should never happen, so a write
        // that removes one is rejected outright. This does not prevent
        // a technical user from injecting a badge ID they haven't
        // legitimately earned (that would require moving all badge
        // eligibility checks server-side, a bigger change than this
        // pass covers) - it only prevents badges from being erased.
        isOwner(userId) &&
        !changedOnly(['hunnies']) &&
        (
          !('badges' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (
            request.resource.data.badges.size() >= resource.data.badges.size() &&
            request.resource.data.badges.hasAll(resource.data.badges)
          )
        )
      ) || (
        // Operators (the two real accounts checked in isOperator()) can
        // grant any amount to anyone, including themselves - this is
        // what the Dev Dashboard's "Grant Hunnies" testing tool needs.
        isOperator() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hunnies', 'counters', 'badges'])
      ) || (
        // Everyone else: hunnies/counters/badges can still increase (this
        // is what real in-app rewards use - liking someone's post,
        // uploading a resource, being upvoted), but capped to a small
        // amount matching the largest real single-action reward (+5 for
        // an upload). Critically, this branch does NOT check ownership -
        // it deliberately allows both the cross-user case (someone else's
        // like/upvote rewards you) and the self-increase case (your own
        // upload rewards you) - the cap is what prevents a malicious
        // unbounded self-grant, not an ownership check, since a real
        // upload reward is a legitimate same-uid increase there's no way
        // to distinguish from a fake one at the rules level alone.
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hunnies', 'counters', 'badges']) &&
        (!('hunnies' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (request.resource.data.hunnies > resource.data.hunnies &&
           request.resource.data.hunnies - resource.data.hunnies <= 10))
      );
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.type is string;
      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId)
        ||
        (changedOnly(['likes', 'bookmarks', 'commentCount'])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.text == resource.data.text
          && request.resource.data.type == resource.data.type)
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isOperator());

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isOperator());
      }
    }

    match /dms/{conversationId} {
      allow read: if isOperator() || resource == null || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in dmParticipants(conversationId);
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.auth.uid in dmParticipants(conversationId);
        allow update, delete: if false;
      }
    }

    match /library/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.tags is list;
      allow update: if isSignedIn() && (
        resource.data.uploaderId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvoters'])
      );
      allow delete: if isSignedIn() && resource.data.uploaderId == request.auth.uid;
    }

    match /calendar/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.type is string
        && request.resource.data.date is string;
      allow update, delete: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isOperator());
    }

    match /hunnies_transactions/{txId} {
      allow read: if isOperator() || (isSignedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid));
      allow create: if isSignedIn() && (
        request.resource.data.fromId == request.auth.uid ||
        (request.resource.data.fromId == null && request.resource.data.toId is string)
      );
      allow update, delete: if false;
    }

    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /active_gifts/{giftId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && request.resource.data.type is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 300
        && request.resource.data.read == false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /buzz_sessions/{sessionId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in resource.data.pendingInviteIds
      );
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      // Covers invite/accept/decline/leave/lock-toggle in one rule —
      // anyone already connected to the session (member or invited) has
      // a legitimate reason to touch it; there's no meaningfully finer
      // boundary worth the added rule complexity here.
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in resource.data.pendingInviteIds
      );
      allow delete: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/buzz_sessions/$(sessionId)).data.memberIds;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/buzz_sessions/$(sessionId)).data.memberIds;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
